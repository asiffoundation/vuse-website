# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ website (dùng cho sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.vu-se.com

# Gửi email (tuỳ chọn). Bỏ trống = chỉ lưu vào Supabase, không gửi email.
# Resend: https://resend.com — verify domain vu-se.com rồi tạo API key.
RESEND_API_KEY=
EMAIL_FROM="Việt Úc <no-reply@vu-se.com>"
EMAIL_TO=info@vu-se.com
